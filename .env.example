# Public site URL — used for canonical links, Open Graph tags and sitemap.xml.
# May be left empty or unset: the site then falls back to the Vercel
# deployment domain, and finally to the value in lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://azzhab.com

# Where the three forms POST their JSON payload
# (Formspree, Getform, Web3Forms, or your own API).
# Leave empty and the forms fall back to opening the visitor's mail client.
NEXT_PUBLIC_FORM_ENDPOINT=
